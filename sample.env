# Required: your own Telegram app and assistant USER session
API_ID=
API_HASH=
SESSION=
# Recommended for inline keyboards; get a bot token from @BotFather
BOT_TOKEN=
# Optional Telegram user IDs separated by spaces
SUDOERS=
PREFIX=/ !
LANGUAGE=en
QUALITY=high
STREAM_MODE=audio
ADMINS_ONLY=false
# Optional eligible Premium custom button emoji ID
CUSTOM_EMOJI_ID=
# Only needed for original Spotify playlist/track metadata support
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# User-provided premium emoji catalog (fallback is automatic)
PREMIUM_EMOJIS=true
# Optional force-channel membership gate. Bot must be able to inspect membership.
FORCE_CHANNEL=
FORCE_CHANNEL_URL=
# Persist welcome/moderation settings (mount this directory for Docker)
DATA_DIR=data
